# Copy this file to `.env.local` and fill in the two values.
# Both are PUBLIC values (Supabase dashboard -> Project Settings -> API).
# They are safe to ship in the browser: Row Level Security protects the data.
#
# NEVER put the `service_role` / secret key here or anywhere in this repo.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
